{
  "identifier": "default",
  "description": "主窗口只能调用命令层，不能直接访问文件系统或 shell。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-scan",
    "allow-compare",
    "allow-diff",
    "allow-merge",
    "allow-read-side",
    "allow-prepare-package",
    "allow-execute",
    "dialog:allow-open",
    "allow-rollback-run",
    "allow-resume-run",
    "allow-history",
    "allow-journal-runs",
    "allow-rollback-preview",
    "allow-connections",
    "allow-startup-offers",
    "allow-startup-failure",
    "allow-ssh-secret-service",
    "allow-save-ssh-secret",
    "allow-ssh-secret-status",
    "allow-delete-ssh-secret",
    "allow-host-key-status",
    "allow-clear-host-fingerprint",
    "allow-remote-backup-path",
    "allow-remote-rename-plan",
    "allow-list-connections",
    "allow-save-connection",
    "allow-delete-connection",
    "allow-clear-connection-fingerprint",
    "allow-test-connection",
    "allow-remote-write-prompt",
    "allow-commit-remote-overwrite",
    "allow-app-bak-dir",
    "allow-load-file-picks",
    "allow-save-file-picks",
    "allow-read-ssh-config"
  ]
}
