{
  "productName": "HeTianXia",
  "version": "1.0.0",
  "identifier": "com.hetianxia.app",
  "build": {
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": ".."
    },
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43127"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "合天下",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
